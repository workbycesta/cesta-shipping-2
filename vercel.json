{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "cd website && npm run build",
  "installCommand": "npm install && cd website && npm install",
  "outputDirectory": "website/dist",
  "framework": "vite",
  "rewrites": [
    {
      "source": "/api/manifest/:path*",
      "destination": "https://cesta-shipping-2-production.up.railway.app/api/manifest/:path*"
    },
    {
      "source": "/api/auth/:path*",
      "destination": "https://cesta-shipping-2-production.up.railway.app/api/auth/:path*"
    },
    {
      "source": "/api/bids/:path*",
      "destination": "https://cesta-shipping-2-production.up.railway.app/api/bids/:path*"
    },
    {
      "source": "/api/bids",
      "destination": "https://cesta-shipping-2-production.up.railway.app/api/bids"
    },
    {
      "source": "/api/admin/:path*",
      "destination": "https://cesta-shipping-2-production.up.railway.app/api/admin/:path*"
    },
    {
      "source": "/api/admin",
      "destination": "https://cesta-shipping-2-production.up.railway.app/api/admin"
    },
    {
      "source": "/api/price-config",
      "destination": "https://cesta-shipping-2-production.up.railway.app/api/price-config"
    },
    {
      "source": "/api/lots/:path*",
      "destination": "https://www.b4traders.com/api/lots/:path*"
    },
    {
      "source": "/api/lot_publishes/:path*",
      "destination": "https://www.b4traders.com/api/lot_publishes/:path*"
    },
    {
      "source": "/api/organizations/:path*",
      "destination": "https://www.b4traders.com/api/organizations/:path*"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
